# ==============================================================================
# ARTHOVA ROOT ENVIRONMENT CONFIGURATION (.env.example)
#
# Arthova consists of two microservices:
# 1. Frontend: Next.js 16 (App Router + Tailwind CSS + Drizzle ORM + NextAuth)
# 2. Backend:  Spring Boot 3 (Java 21 + Hibernate + Spring Security)
# ==============================================================================

# --- FRONTEND (Next.js) ---
DATABASE_URL="postgresql://username:password@ep-your-database-pooler.region.aws.neon.tech/neondb?sslmode=require"
BACKEND_URL="http://localhost:8080"
INTERNAL_API_SECRET="your-32-byte-hex-secret-must-match-backend"
AUTH_SECRET="your-32-character-random-auth-secret-key"
GEMINI_API_KEY="AIzaSy..."
CRON_SECRET="your-random-cron-secret-token"

# --- BACKEND (Spring Boot) ---
SPRING_DATASOURCE_URL="jdbc:postgresql://ep-your-database.region.aws.neon.tech/neondb?sslmode=require"
SPRING_DATASOURCE_USERNAME="arthova_app"
SPRING_DATASOURCE_PASSWORD="your-secure-database-password"
INTERNAL_API_SECRET="your-32-byte-hex-secret-must-match-backend"
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001"
PORT=8080
