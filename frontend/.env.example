# ==============================================================================
# ARTHOVA FRONTEND ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to .env.local and populate with your credentials.
# Do NOT commit your real .env.local to GitHub.
# ==============================================================================

# 1. DATABASE (Required)
# PostgreSQL connection string with SSL (supports Neon, Supabase, AWS RDS, local Postgres)
DATABASE_URL="postgresql://username:password@ep-your-database-pooler.region.aws.neon.tech/neondb?sslmode=require"

# 2. BACKEND API (Required)
# URL of the Spring Boot backend service
# Local development: http://localhost:8080
# Production deployment: https://your-backend-app.onrender.com
BACKEND_URL="http://localhost:8080"

# 3. INTERNAL GATEWAY AUTHENTICATION (Required)
# Shared cryptographically secure secret used to sign internal requests between Next.js and Spring Boot.
# Generate with: openssl rand -hex 32
# Must match the INTERNAL_API_SECRET in backend configuration.
INTERNAL_API_SECRET="your-32-byte-hex-secret-must-match-backend"

# 4. NEXTAUTH SESSION SECRET (Required)
# Secret key used to encrypt JWT session cookies and NextAuth tokens.
# Generate with: openssl rand -base64 32 or npx auth secret
AUTH_SECRET="your-32-character-random-auth-secret-key"

# 5. GOOGLE GEMINI AI (Optional, Recommended)
# Powers the AI Wealth Copilot assistant, market sentiment, and predictive qualitative commentary.
# Get a key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY="AIzaSy..."

# 6. CRON MAINTENANCE SECRET (Optional)
# Secret bearer token to authenticate automated cron executions (e.g. cleanup of idempotency keys).
CRON_SECRET="your-random-cron-secret-token"
