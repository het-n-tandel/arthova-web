# ==============================================================================
# ARTHOVA BACKEND ENVIRONMENT CONFIGURATION (.env.example)
# Provide these as environment variables in Render / Docker / local shell.
# ==============================================================================

# 1. DATABASE (Required)
# Spring DataSource JDBC URL, Username, and Password
SPRING_DATASOURCE_URL="jdbc:postgresql://ep-your-database.region.aws.neon.tech/neondb?sslmode=require"
SPRING_DATASOURCE_USERNAME="arthova_app"
SPRING_DATASOURCE_PASSWORD="your-secure-database-password"

# 2. INTERNAL GATEWAY AUTHENTICATION (Required)
# Must strictly match the INTERNAL_API_SECRET configured in the frontend Next.js app.
INTERNAL_API_SECRET="your-32-byte-hex-secret-must-match-frontend"

# 3. CORS ALLOWED ORIGINS (Optional, defaults to http://localhost:3000,http://localhost:3001)
# Comma-separated list of allowed frontend domains
ALLOWED_ORIGINS="http://localhost:3000,https://your-frontend-domain.vercel.app"

# 4. SERVER PORT (Optional, Render/Heroku injects PORT dynamically; defaults to 8080)
PORT=8080

# 5. JPA HIBERNATE DDL (Optional, defaults to validate)
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
